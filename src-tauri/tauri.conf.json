{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Phasr",
  "version": "0.3.1",
  "identifier": "sh.phasr.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build && pnpm build:sidecar",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Phasr",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "maximized": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' https://*.clerk.accounts.dev https://*.clerk.com",
        "connect-src": "'self' ipc: http://ipc.localhost https://*.clerk.accounts.dev https://*.clerk.com https://clerk-telemetry.com https://*.supabase.co wss://*.supabase.co https://*.ingest.us.sentry.io https://*.ingest.sentry.io",
        "img-src": "'self' asset: http://asset.localhost data: blob: https://img.clerk.com https://*.clerk.accounts.dev",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:",
        "frame-src": "'self' https://*.clerk.accounts.dev https://*.clerk.com",
        "object-src": "'none'",
        "base-uri": "'self'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' https://*.clerk.accounts.dev https://*.clerk.com",
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420 https://*.clerk.accounts.dev https://*.clerk.com https://clerk-telemetry.com https://*.supabase.co wss://*.supabase.co https://*.ingest.us.sentry.io https://*.ingest.sentry.io",
        "img-src": "'self' asset: http://asset.localhost data: blob: https://img.clerk.com https://*.clerk.accounts.dev",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:",
        "frame-src": "'self' https://*.clerk.accounts.dev https://*.clerk.com",
        "object-src": "'none'",
        "base-uri": "'self'"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["phasr"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "externalBin": ["binaries/phasr-cli"],
    "category": "DeveloperTool",
    "copyright": "Copyright © 2026 Phasr Contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "background": "icons/dmg-background.png"
      }
    }
  }
}
