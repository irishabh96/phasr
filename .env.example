# Copy this file to .env.local and fill in real values for development.
# .env.local is gitignored so secrets never get committed.

# Clerk (required for auth gate)
# Get this from clerk.com → your application → API Keys → Publishable Key
VITE_CLERK_PUBLISHABLE_KEY=

# Supabase (added in Phase 6 — leave blank for now)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
