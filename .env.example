# Auth + cloud sync
#
# Phasr requires Clerk authentication. Supabase powers cross-device sync.
# Use the HTTPS desktop callback bridge in Clerk's allowed redirect URLs;
# the bridge hands the OAuth result back to the app via phasr://.
#
# Contributors: use YOUR OWN Clerk + Supabase projects. Do not request
# or use the maintainer's production keys.

VITE_CLERK_PUBLISHABLE_KEY=
VITE_CLERK_DESKTOP_CALLBACK_URL=https://phasr-auth-bridge.vercel.app/callback
VITE_CLERK_SESSION_JWT_TEMPLATE=phasr_desktop
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Sentry — OPTIONAL
#
# When set, the React renderer sends client-side errors to Sentry. The
# sample rates must be values between 0 and 1.

VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=
VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=
VITE_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=
