# Cloud sync — OPTIONAL
#
# When all three are set, Phasr starts in cloud mode: sign-in with Clerk
# and cross-device sync via Supabase. When any are missing, the app
# falls back to local-only mode (SQLite only, no auth UI).
#
# Contributors: use YOUR OWN Clerk + Supabase projects. Do not request
# or use the maintainer's production keys.

VITE_CLERK_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
