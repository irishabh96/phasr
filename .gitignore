# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Node
node_modules
dist
dist-ssr
.vercel
*.local

# A repo-local pnpm store, which `pnpm install` falls back to when it can't
# reach the global one. node_modules is ignored; this never was — and since
# a phasr worktree is itself a workspace, the ~17k untracked paths it adds
# come straight back through `git status --untracked-files=all` and wedge
# the UI on open.
.pnpm-store/

# Tauri / Rust build artifacts
src-tauri/target/
src-tauri/gen/schemas

# TypeScript incremental build outputs
*.tsbuildinfo

# TanStack Router plugin cache
.tanstack/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Env
.env
.env.local
.env.*.local

# Test artifacts
coverage/
playwright-report/
test-results/

# Phasr local data dir (used by E2E tests)
.phasr-test/

# Claude Code session files (plans, etc.)
.claude/
# Safe Agentic Workflow assets
agent-outputs/
agents/
api/
archive/
ci/
ci-cd/
# Anchored to repo root: bare `commands/` also matched src-tauri/src/commands
# and silently hid new backend command modules from git.
/commands/
config/
database/
guides/
# Anchored to repo root: bare `hooks/` also matched src/lib/hooks and hid it
# from Tailwind v4's content scan (which prunes .gitignored paths).
/hooks/
onboarding/
patterns/
release/
releases/
rules/
security/
skills/
sop/
team/
templates/
testing/
# Anchored to repo root: bare `ui/` also matched src/components/ui and hid it
# from Tailwind's content scan — every class used only there (GlassTooltip,
# GlassButton, …) was silently never generated. This is the tooltip-transparency bug.
/ui/
whitepapers/
workflow/
.gemini/
.codex/
.cursor/
.agents/
dark-factory/
# SAFe-template docs stay ignored, EXCEPT phasr's own design/architecture docs.
/docs/*
!/docs/design/
!/docs/adr/
!/docs/PERFORMANCE-RETENTION-REPORT.md
!/docs/RELEASE-*.md
!/docs/MANUAL-VERIFICATION.md
patterns_library/
# SAFe-template scripts stay ignored, EXCEPT phasr's own project scripts.
/scripts/*
!/scripts/generate-dmg-background.swift
!/scripts/check-template-urls.mjs
# Referenced by docs/adr/ADR-002 — a tracked ADR must not point at an
# untracked script.
!/scripts/wkwebview-wasm-probe.swift
specs_templates
CLAUDE.md
AGENTS.md
.geminiignore
# aidb dev-tooling runtime state (accidentally committed with the notes work)
.ai/
*.seg
