]2;git log -p -3 -- src/lib/terminal/reflow.ts]1;git[33mcommit 2bbf69b4059726bfe22818b8b1a08c48303ecd38[m
Author: Rishabh Bhatia <irishabh96@gmail.com>
Date:   Fri Aug 21 22:00:23 2026 +0530

    fix(terminal): stop reflowing the grid, rebuild it at the new width
    
    A panel toggle changed the terminal's width, and every width round trip
    converted trailing blank rows below the cursor into leading history rows
    above it. The content marched down the screen a row or two per toggle and
    never came back up. `ghostty_terminal_resize` takes no anchor and there is
    nothing inside it to reach for — so phasr stops calling it on live content.
    
    A row change resizes. A width change waits for the container to stop
    moving and then rebuilds: `reset()` frees the buffer, `resize()` sizes the
    canvas at the new grid, and the retained output is replayed into it. The
    rewrap still runs — against an empty grid, where it has nothing to spend.
    Every user-caused resize goes through the new `fitAnchored()`: panel
    toggles, window drags, font-size steps. `fit()` stays for the pre-PTY
    measurement, which must be immediate and has no buffer to lose.
    
    Naively skipping the resize was the trap it looks like: the grid keeps its
    old width and clips every line at the right-hand edge of a pane it no
    longer fits. So each test asserts the pane fit alongside the position, and
    `settle()` had to be rewritten — the grid no longer tracks the animation,
    so "the grid stopped changing" resolved before anything had happened.
    
    Both `test.fail()` cases are ordinary assertions now, which is the proof.
    
    Also collected, for free: one `resize_task` per gesture instead of the
    thirteen a 220 ms panel animation used to send, and an open/close faster
    than the settle costs nothing at all.
    
    Two things a fresh grid forgets had to be carried over. DEC modes are read
    off the old grid and re-asserted where they disagree — a program sets them
    once at startup, so they are the first thing to age out of a bounded
    window, and losing them stops bracketed paste bracketing and turns ↑ into
    the wrong sequence. And the alternate screen is re-entered ahead of the
    replay when the `?1049h` that entered it is no longer retained, so a TUI's
    frames are never painted over the user's scrollback.
    
    The cost is scrollback older than the 1 MiB retained window, an
    approximate scroll position, a cleared selection, and ~40 ms once per
    gesture. Measured, with the alternatives and the evidence, in ADR-002.
    
    Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>

[1mdiff --git a/src/lib/terminal/reflow.ts b/src/lib/terminal/reflow.ts[m
[1mnew file mode 100644[m
[1mindex 0000000..e9802de[m
[1m--- /dev/null[m
[1m+++ b/src/lib/terminal/reflow.ts[m
[36m@@ -0,0 +1,115 @@[m
[32m+[m[32m/**[m
[32m+[m[32m * What a terminal does when its container changes size — the policy half[m
[32m+[m[32m * of the fix for ADR-002's "reflow anchor", kept pure so it can be argued[m
[32m+[m[32m * with in a unit test instead of in a browser.[m
[32m+[m[32m *[m
[32m+[m[32m * The defect: ghostty-web's `ghostty_terminal_resize` takes `(handle,[m
[32m+[m[32m * cols, rows)` and no anchor, and every width round trip permanently[m
[32m+[m[32m * converts trailing blank rows below the cursor into leading history rows[m
[32m+[m[32m * above it. Content marches down the screen a row or two per panel toggle[m
[32m+[m[32m * and never comes back up.[m
[32m+[m[32m *[m
[32m+[m[32m * The policy: **never rewrap live content.** A row-only change is safe and[m
[32m+[m[32m * is applied immediately; a column change is applied by rebuilding the[m
[32m+[m[32m * grid at the new width and replaying the retained output into it, so the[m
[32m+[m[32m * buggy path is never entered with anything in the buffer.[m
[32m+[m[32m */[m
[32m+[m
[32m+[m[32mexport interface Grid {[m
[32m+[m[32m  cols: number;[m
[32m+[m[32m  rows: number;[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32mexport type ResizePlan =[m
[32m+[m[32m  /** The grid already matches the container. */[m
[32m+[m[32m  | "none"[m
[32m+[m[32m  /**[m
[32m+[m[32m   * Rows changed, columns did not — nothing rewraps, so nothing can drift.[m
[32m+[m[32m   * Measured in ADR-002: a rows-only round trip leaves `scrollback`[m
[32m+[m[32m   * untouched. Applied immediately, which keeps a tab reveal and a[m
[32m+[m[32m   * vertical-only window resize as snappy as they were.[m
[32m+[m[32m   */[m
[32m+[m[32m  | "resize"[m
[32m+[m[32m  /**[m
[32m+[m[32m   * The width changed. Rewrapping is the trigger, so the grid is thrown[m
[32m+[m[32m   * away and rebuilt at the new width instead.[m
[32m+[m[32m   */[m
[32m+[m[32m  | "rebuild";[m
[32m+[m
[32m+[m[32mexport function planResize(current: Grid, target: Grid): ResizePlan {[m
[32m+[m[32m  if (target.cols === current.cols) {[m
[32m+[m[32m    return target.rows === current.rows ? "none" : "resize";[m
[32m+[m[32m  }[m
[32m+[m[32m  return "rebuild";[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32m/** DECSET 1049 — the alternate screen buffer. Named because the rebuild[m
[32m+[m[32m *  path has to reason about it on its own, not merely repair it: a replay[m
[32m+[m[32m *  that no longer contains the sequence which entered it has to be told[m
[32m+[m[32m *  which screen it belongs to. */[m
[32m+[m[32mexport const ALT_SCREEN_MODE = 1049;[m
[32m+[m
[32m+[m[32m/**[m
[32m+[m[32m * DEC private modes that must survive a rebuild.[m
[32m+[m[32m *[m
[32m+[m[32m * A rebuilt grid is a *fresh* terminal: it has forgotten every mode the[m
[32m+[m[32m * running program switched on. Most of them are re-established by the[m
[32m+[m[32m * replay — the bytes that set them are in the retained stream — but only[m
[32m+[m[32m * while those bytes are still inside the budget. A TUI sets its modes once[m
[32m+[m[32m * at startup and then runs for hours, so on any long-lived terminal they[m
[32m+[m[32m * are the FIRST thing to fall out of the window, and losing them is not[m
[32m+[m[32m * cosmetic: bracketed paste stops bracketing, the wheel stops reporting,[m
[32m+[m[32m * arrow keys start sending the wrong sequence, and the alternate screen[m
[32m+[m[32m * silently becomes the primary one.[m
[32m+[m[32m *[m
[32m+[m[32m * So the modes are read off the old grid and re-asserted on the new one[m
[32m+[m[32m * whenever they disagree, which makes the replay's own mode bytes a[m
[32m+[m[32m * bonus rather than a requirement.[m
[32m+[m[32m *[m
[32m+[m[32m * 1049 leads the list because entering the alternate screen CLEARS it: any[m
[32m+[m[32m * repair that followed a screen switch would be applied to a screen the[m
[32m+[m[32m * user is not looking at. When the replay has already put the terminal in[m
[32m+[m[32m * the right screen — the common case, and the one that reconstructs the[m
[32m+[m[32m * primary screen's scrollback underneath as well — 1049 matches and[m
[32m+[m[32m * nothing is emitted.[m
[32m+[m[32m */[m
[32m+[m[32mexport const RETAINED_DEC_MODES: readonly number[] = [[m
[32m+[m[32m  ALT_SCREEN_MODE, // alternate screen buffer (+ save/restore cursor)[m
[32m+[m[32m  1, // DECCKM — application cursor keys[m
[32m+[m[32m  7, // DECAWM — autowrap[m
[32m+[m[32m  9, // X10 mouse reporting[m
[32m+[m[32m  12, // att610 — cursor blink[m
[32m+[m[32m  25, // DECTCEM — cursor visibility[m
[32m+[m[32m  1000, // mouse: button events[m
[32m+[m[32m  1002, // mouse: button + drag[m
[32m+[m[32m  1003, // mouse: any motion[m
[32m+[m[32m  1004, // focus in/out reporting[m
[32m+[m[32m  1005, // UTF-8 mouse encoding[m
[32m+[m[32m  1006, // SGR mouse encoding[m
[32m+[m[32m  1015, // urxvt mouse encoding[m
[32m+[m[32m  1016, // SGR pixel mouse encoding[m
[32m+[m[32m  2004, // bracketed paste[m
[32m+[m[32m];[m
[32m+[m
[32m+[m[32mexport function decModeSequence(mode: number, on: boolean): string {[m
[32m+[m[32m  return `\x1b[?${mode}${on ? "h" : "l"}`;[m
[32m+[m[32m}[m
[32m+[m
[32m+[m[32m/**[m
[32m+[m[32m * The sequence that moves a freshly rebuilt grid from `actual` to[m
[32m+[m[32m * `wanted`, in `RETAINED_DEC_MODES` order. Empty when they already agree,[m
[32m+[m[32m * which is what the common case should produce.[m
[32m+[m[32m */[m
[32m+[m[32mexport function modeRepairSequence([m
[32m+[m[32m  wanted: ReadonlyMap<number, boolean>,[m
[32m+[m[32m  actual: ReadonlyMap<number, boolean>,[m
[32m+[m[32m): string {[m
[32m+[m[32m  let out = "";[m
[32m+[m[32m  for (const mode of RETAINED_DEC_MODES) {[m
[32m+[m[32m    if (!wanted.has(mode)) continue;[m
[32m+[m[32m    const want = wanted.get(mode)!;[m
[32m+[m[32m    if (actual.get(mode) === want) continue;[m
[32m+[m[32m    out += decModeSequence(mode, want);[m
[32m+[m[32m  }[m
[32m+[m[32m  return out;[m
[32m+[m[32m}[m
